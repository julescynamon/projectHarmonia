---
// src/components/HomePillars.astro
import Button from './ui/Button.astro';

interface Pillar {
  title: string;
  subtitle: string;
  description: string;
  cta: string;
  href: string;
}

const pillars: Pillar[] = [
  {
    title: 'MAISON',
    subtitle: "L'Offre Signature en Duo",
    description:
      'Le lien « Miroir » entre l\'humain et l\'animal. Harmonisation systémique du foyer dans son ensemble.',
    cta: 'Découvrir MAISON',
    href: '/maison',
  },
  {
    title: 'SATTVA',
    subtitle: "L'Offre Humaine",
    description:
      "Santé naturelle et réalignement énergétique de la personne. Naturopathie, soins vibratoires, retour à l'essentiel.",
    cta: 'Découvrir SATTVA',
    href: '/sattva',
  },
  {
    title: 'AÏA',
    subtitle: "L'Offre Animale",
    description:
      "L'essence et l'instinct de l'animal. Naturopathie animale, communication, magnétisme.",
    cta: 'Découvrir AÏA',
    href: '/aia',
  },
];
---

<section
  id="piliers"
  class="py-20 md:py-32 bg-gradient-to-b from-cream via-white to-cream/40 relative overflow-hidden"
  aria-labelledby="piliers-heading"
>
  <div class="absolute inset-0 opacity-3 pointer-events-none" aria-hidden="true">
    <img
      src="/images/sacred-geometry.svg"
      alt=""
      class="w-full h-full object-cover bg-gradient-to-r from-sage/20 to-gold/20 bg-clip-content"
      loading="lazy"
    />
  </div>
  <div class="absolute top-20 left-8 w-56 h-56 bg-sage/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-32 right-8 w-72 h-72 bg-gold/5 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20" data-aos="fade-up" data-aos-duration="900">
      <p class="font-slogan text-sm uppercase tracking-[0.2em] text-eucalyptus mb-4">Maison Sattvaïa</p>
      <h2 id="piliers-heading" class="font-heading text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-ebony leading-tight uppercase tracking-[0.12em] md:tracking-[0.15em]">
        Vos accompagnements sur-mesure
      </h2>
      <p class="mt-6 text-lg md:text-xl text-eucalyptus font-slogan leading-relaxed">
        Trois dimensions de soin, accueillies avec la même exigence technique et la même profondeur vibratoire.
      </p>
      <div class="w-24 h-1 bg-gradient-to-r from-sage to-gold mx-auto mt-8 rounded-full" aria-hidden="true"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 lg:gap-10 max-w-6xl mx-auto">
      {pillars.map((pillar, index) => (
        <article
          class="flex flex-col h-full rounded-3xl border border-sage/15 bg-white/90 shadow-soft p-8 md:p-10 transition-all duration-500 hover:shadow-medium hover:border-sage/25"
          data-aos="fade-up"
          data-aos-duration="900"
          data-aos-delay={index * 100}
      >
          <header class="mb-6 text-center md:text-left">
            <h3 class="font-heading text-2xl md:text-3xl text-ebony tracking-wide">{pillar.title}</h3>
            <p class="mt-3 font-slogan text-sm uppercase tracking-wider text-sage">{pillar.subtitle}</p>
          </header>
          <p class="font-slogan text-ebony/90 leading-relaxed flex-grow text-center md:text-left">
            {pillar.description}
          </p>
          <div class="mt-10 flex justify-center md:justify-start">
            <Button href={pillar.href} variant="outline" size="md" class="w-full md:w-auto text-center">
              {pillar.cta}
            </Button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .shadow-soft {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .shadow-medium {
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.08);
  }
</style>

---
// src/components/HomeToolkit.astro — outils + modes d'intervention (section unifiée)
const modes = [
  {
    title: 'À domicile',
    line: 'Je me déplace dans votre espace de vie',
    icon: 'home' as const,
  },
  {
    title: 'En visio',
    line: 'Un accompagnement sans frontières géographiques',
    icon: 'visio' as const,
  },
];
---

<section
  id="outils"
  class="py-20 md:py-32 bg-gradient-to-b from-white via-cream/30 to-cream/15 relative overflow-hidden"
  aria-labelledby="outils-heading"
>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[min(90%,42rem)] h-px bg-gradient-to-r from-transparent via-sage/30 to-transparent"></div>
  <div class="absolute top-32 right-0 w-72 h-72 bg-sage/[0.07] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-40 left-0 w-64 h-64 bg-gold/[0.08] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-3xl mx-auto text-center" data-aos="fade-up" data-aos-duration="900">
      <h2 id="outils-heading" class="font-heading text-3xl md:text-4xl lg:text-[2.65rem] text-ebony leading-tight">
        Une ingénierie complète du Vivant
      </h2>
      <div class="w-20 h-px bg-gradient-to-r from-sage to-gold mx-auto mt-8 rounded-full" aria-hidden="true"></div>
      <p class="mt-10 font-slogan text-lg md:text-xl text-ebony/90 leading-relaxed text-left md:text-center">
        Parce que la précision demande des outils variés, je puise dans une valise thérapeutique multidimensionnelle
        pour répondre à votre fréquence exacte&nbsp;:
      </p>
      <p class="mt-8 font-slogan text-base md:text-lg text-eucalyptus leading-[1.85] text-center tracking-wide">
        Naturopathie (Humaine &amp; Animale) • Lecture Vibratoire • Magnétisme • Médecine Traditionnelle Chinoise •
        Réflexologie • Communication Animale • Massages Thérapeutiques.
      </p>
    </div>

    <div class="mt-20 md:mt-24 pt-16 md:pt-20 border-t border-sage/15" data-aos="fade-up" data-aos-duration="900" id="modes-intervention">
      <div class="text-center max-w-2xl mx-auto mb-10 md:mb-12">
        <p class="font-slogan text-xs uppercase tracking-[0.2em] text-sage mb-3">Rencontre</p>
        <h3 class="font-heading text-3xl md:text-4xl text-ebony">Modes d'intervention</h3>
        <p class="mt-4 font-slogan text-eucalyptus text-lg leading-relaxed">
          La même qualité d'écoute, quelle que soit la distance.
        </p>
      </div>

      <!-- Présence territoriale + modes (sans visuel carte) -->
      <div
        class="max-w-6xl mx-auto rounded-[2rem] border border-sage/12 bg-gradient-to-br from-white/95 via-cream/25 to-white/90 p-1.5 shadow-panel"
      >
        <div class="rounded-[1.65rem] bg-white/55 backdrop-blur-[6px] px-5 py-8 md:px-8 md:py-10 lg:px-10 lg:py-12">
          <div class="grid lg:grid-cols-12 gap-6 lg:gap-8 lg:items-stretch">
            <div class="lg:col-span-5 flex min-h-0">
              <div
                class="relative flex-1 flex flex-col justify-center overflow-hidden rounded-2xl border border-sage/10 bg-gradient-to-br from-white to-cream/35 pl-4 md:pl-5 pr-5 py-6 md:py-8 shadow-soft w-full"
                data-aos="fade-up"
                data-aos-duration="900"
              >
                <div
                  class="absolute left-0 top-3 bottom-3 w-[3px] rounded-full bg-gradient-to-b from-sage via-eucalyptus to-gold opacity-90"
                  aria-hidden="true"
                ></div>
                <div class="text-center lg:text-left">
                  <p class="font-slogan text-[0.65rem] sm:text-xs uppercase tracking-[0.18em] text-sage">
                    Présence au plus près de vous
                  </p>
                  <p class="font-heading text-xl md:text-2xl text-ebony mt-3 tracking-tight leading-snug">
                    Gard · Vaucluse · Drôme · Ardèche
                  </p>
                  <p class="font-slogan text-sm text-eucalyptus/95 mt-4 leading-relaxed max-w-sm mx-auto lg:mx-0">
                    Zone d'intervention à domicile — ailleurs, la visio ouvre le même accompagnement.
                  </p>
                </div>
              </div>
            </div>

            <div class="lg:col-span-7 flex flex-col gap-4 md:gap-5 min-h-0">
              {modes.map((mode, i) => (
                <div
                  class="group relative overflow-hidden rounded-2xl border border-sage/10 bg-gradient-to-br from-white to-cream/35 pl-4 md:pl-5 pr-5 py-4 md:py-5 shadow-soft transition-all duration-500 hover:border-sage/20 hover:shadow-medium"
                  data-aos="fade-up"
                  data-aos-duration="900"
                  data-aos-delay={80 + i * 70}
                >
                  <div
                    class="absolute left-0 top-3 bottom-3 w-[3px] rounded-full bg-gradient-to-b from-sage via-eucalyptus to-gold opacity-90"
                    aria-hidden="true"
                  ></div>
                  <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-5 text-center sm:text-left">
                    <div
                      class="shrink-0 mx-auto sm:mx-0 w-12 h-12 rounded-xl bg-gradient-to-br from-sage/12 to-gold/10 flex items-center justify-center text-eucalyptus ring-1 ring-sage/10"
                    >
                      {mode.icon === 'home' ? (
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.35">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                      ) : (
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.35">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                      )}
                    </div>
                    <div class="min-w-0">
                      <h4 class="font-heading text-lg md:text-xl text-ebony mb-1">{mode.title}</h4>
                      <p class="font-slogan text-ebony/80 leading-relaxed text-sm md:text-base">{mode.line}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .shadow-soft {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .shadow-medium {
    box-shadow: 0 10px 28px -8px rgba(19, 18, 18, 0.1);
  }

  .shadow-panel {
    box-shadow:
      0 4px 6px -1px rgba(19, 18, 18, 0.04),
      0 24px 48px -20px rgba(116, 140, 105, 0.12);
  }
</style>

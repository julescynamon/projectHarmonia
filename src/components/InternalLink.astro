---
// src/components/InternalLink.astro
// Composant pour les liens internes discrets et contextuels

interface Props {
  href: string;
  label: string;
  ariaLabel?: string;
  class?: string;
}

const { href, label, ariaLabel, class: extraClass } = Astro.props;
---

<a 
  href={href}
  aria-label={ariaLabel ?? label}
  class={`underline underline-offset-2 hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-sage focus:ring-offset-2 transition-all duration-200 ${extraClass ?? ''}`}
>
  {label}
</a>

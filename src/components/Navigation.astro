---
import Button from "./ui/Button.astro";
import AuthButton from '../components/navigation/AuthButton.astro';
import CartIcon from './shop/CartIcon.astro';

// Récupération de l'utilisateur depuis Astro.locals
const user = Astro.locals.user;

// Nouvelle structure de navigation avec les menus déroulants
interface NavLink {
  href: string;
  text: string;
  submenu?: NavLink[];
}

const navLinks: NavLink[] = [
  { href: "/", text: "Accueil" },
  {
    text: "Accompagnements",
    href: "#",
    submenu: [
      { href: "/maison", text: "MAISON | l'offre signature ( binôme )" },
      { href: "/sattva", text: "SATTVA | l'offre humaine" },
      { href: "/aia", text: "AÏA | l'offre animale" },
      { href: "/accompagnements/reservation", text: "→ Réserver un accompagnement" },
    ],
  },
  { href: "/blog", text: "Blog" },
  { href: "/a-propos", text: "À propos" },
  { href: "/contact", text: "Contact" },
];
---
<nav class="fixed w-full z-[100] top-0 transition-all duration-300" id="mainNav">
  <div class="container mx-auto px-4 py-2">
    <div class="xl:bg-white/10 xl:backdrop-blur-md xl:rounded-full xl:shadow-sm xl:px-4 xl:max-w-6xl xl:mx-auto">
      <div class="flex items-center h-16 xl:h-20 xl:justify-between">
        <!-- Logo (Gauche) -->
        <a href="/" class="flex-shrink-0 min-w-0">
          <img src="/favicon/favicon-96x96.png" alt="Maison Sattvaïa" width="96" height="96" class="h-12 w-12 object-contain" />
        </a>

        <!-- Navigation Desktop (Centrée) -->
        <div class="hidden xl:flex items-center space-x-4 xl:flex-grow xl:justify-center min-w-0">
            {navLinks.map(link => (
              link.submenu ? (
                <div class="relative group" tabindex="0">
                  <a
                    href={link.href}
                    class="font-slogan text-sm tracking-wide text-ebony hover:text-gold transition-colors duration-200 flex items-center"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {link.text}
                    <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                  </a>
                  <div class="absolute left-0 mt-2 min-w-[17.5rem] max-w-[20rem] bg-white rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-20">
                    <div class="py-2">
                      {link.submenu.map(subItem => (
                        <a
                          href={subItem.href}
                          class="block px-4 py-2.5 text-sm text-ebony hover:bg-gold/10 hover:text-gold transition-colors duration-200 leading-snug whitespace-normal"
                        >
                          {subItem.text}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                <a
                  href={link.href}
                  class="font-slogan text-sm tracking-wide text-ebony hover:text-gold transition-colors duration-200"
                >
                  {link.text}
                </a>
              )
            ))}
        </div>

        <!-- Actions de droite Desktop -->
        <div class="hidden xl:flex items-center space-x-3 min-w-0">
          <div class="flex items-center gap-4">
            <CartIcon />
            <AuthButton user={user} />
          </div>
        </div>

        <!-- Actions Mobile (visible uniquement sur mobile) -->
        <div class="xl:hidden flex items-center gap-4 ml-auto">
          <CartIcon />
          <button
            type="button"
            class="p-2 text-ebony hover:text-gold transition-colors duration-200"
            aria-label="Menu"
            aria-expanded="false"
            id="menuButton"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-6 h-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Overlay Menu Mobile -->
  <div
    class="fixed inset-0 bg-cream/95 backdrop-blur-sm transition-all duration-300 transform translate-x-full xl:hidden z-[110]"
    id="mobileMenu"
  >
    <div class="container mx-auto px-4 py-8">
      <div class="flex justify-end">
        <button
          type="button"
          class="p-2 text-ebony hover:text-gold transition-colors duration-200"
          aria-label="Fermer le menu"
          id="closeMenuButton"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>
      <div class="flex flex-col space-y-4 mt-8">
        {navLinks.map(link => (
          <div class="mobile-nav-item">
            <a
              href={link.submenu ? "#" : link.href}
              class="font-slogan text-lg text-ebony hover:text-gold transition-colors duration-200 flex items-center justify-between cursor-pointer"
              aria-expanded={link.submenu ? "false" : undefined}
              aria-haspopup={link.submenu ? "true" : undefined}
            >
              {link.text}
              {link.submenu && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  class="w-4 h-4 transform transition-transform duration-200"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              )}
            </a>
            {link.submenu && (
              <div class="mobile-submenu overflow-hidden transition-[max-height] duration-300 ease-in-out" style="max-height: 0;" role="menu">
                <div class="pl-4 mt-2 space-y-2">
                  {link.submenu.map(subItem => (
                    <a
                      href={subItem.href}
                      class="block text-base text-ebony hover:text-gold transition-colors duration-200"
                      role="menuitem"
                    >
                      {subItem.text}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
        <!-- Boutons d'action dans le menu mobile -->
        <div class="w-full border-t border-gray-200 pt-6 flex flex-col items-center gap-4" data-user={JSON.stringify(!!user)} data-user-email={user?.email || ''}>
          <AuthButton user={user} />
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  // Gestion du menu mobile
  const menuButton = document.getElementById('menuButton');
  const closeMenuButton = document.getElementById('closeMenuButton');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileNavItems = document.querySelectorAll('.mobile-nav-item');

  function closeMobileMenu() {
    if (!mobileMenu || !menuButton) return;
    menuButton.setAttribute('aria-expanded', 'false');
    mobileMenu.classList.add('translate-x-full');

    mobileNavItems.forEach(item => {
      const link = item.querySelector('a[aria-haspopup="true"]');
      const submenu = item.querySelector('.mobile-submenu') as HTMLElement | null;
      const arrow = link?.querySelector('svg');
      if (link) link.setAttribute('aria-expanded', 'false');
      if (submenu) submenu.style.maxHeight = '0';
      arrow?.classList.remove('rotate-180');
    });
  }

  function openMobileMenu() {
    if (!mobileMenu || !menuButton) return;
    menuButton.setAttribute('aria-expanded', 'true');
    mobileMenu.classList.remove('translate-x-full');
  }

  function toggleMenu() {
    const isExpanded = menuButton?.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  }

  menuButton?.addEventListener('click', toggleMenu);
  closeMenuButton?.addEventListener('click', closeMobileMenu);

  // Fermer le menu mobile lorsqu'un lien de navigation est activé
  const mobileMenuLinks = mobileMenu?.querySelectorAll('a[href]');
  mobileMenuLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '';
      if (href && href !== '#') {
        closeMobileMenu();
      }
    });
  });

  // Gestion des sous-menus mobiles
  mobileNavItems.forEach(item => {
    const link = item.querySelector('a[aria-haspopup="true"]');
    const submenu = item.querySelector('.mobile-submenu') as HTMLElement;
    const arrow = link?.querySelector('svg');

    link?.addEventListener('click', (e) => {
      if (submenu) {
        e.preventDefault();
        const isExpanded = link.getAttribute('aria-expanded') === 'true';
        link.setAttribute('aria-expanded', (!isExpanded).toString());

        // Toggle la classe pour contrôler la max-height
        if (!isExpanded) {
          submenu.style.maxHeight = submenu.scrollHeight + "px"; // Définit la max-height à la hauteur réelle du contenu
        } else {
          submenu.style.maxHeight = "0";
        }

        arrow?.classList.toggle('rotate-180');
      }
    });
  });

  // Réinitialisation défensive après navigation/historique
  window.addEventListener('pageshow', closeMobileMenu);
  document.addEventListener('astro:after-swap', closeMobileMenu);
  closeMobileMenu();

</script>

<style is:global>
  /* Styles pour les sous-menus mobiles */
  .mobile-submenu {
    transition: max-height 0.3s ease-in-out;
    overflow: hidden;
  }

  /* Nouvelle règle pour le fond de la navigation mobile */
  @media (max-width: 1279px) {
    #mainNav {
      background-color: #f4f1ed; /* Couleur 'cream' */
    }
  }

  /* Règle pour s'assurer que le fond est transparent sur desktop */
  @media (min-width: 1280px) {
    #mainNav {
      background-color: transparent;
    }
  }
</style>

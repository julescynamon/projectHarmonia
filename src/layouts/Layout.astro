---
// src/layouts/Layout.astro
import type { SEO } from '../lib/seo';
import { getSiteConfig } from '../lib/site-config';
import { initSEOMetrics } from '../lib/analytics';
import Analytics from '@vercel/analytics/astro';
import  SpeedInsights  from "@vercel/speed-insights/astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  seo?: SEO;
}

const {
  title = 'La Maison Sattvaïa - Naturopathie & Soins Chamaniques',
  description = 'Découvrez nos services de naturopathie et soins chamaniques pour votre bien-être naturel.',
  image = '/images/og-image.webp',
  canonical,
  noindex = false,
  seo = {}
} = Astro.props;

const siteConfig = getSiteConfig();
const canonicalURL = canonical ? new URL(canonical, siteConfig.site) : new URL(Astro.url.pathname, siteConfig.site);
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload des ressources critiques -->
    <link rel="preload" href="/fonts/cormorant-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    
    <!-- Preload des images critiques -->
    <link rel="preload" href="/images/hero-bg.webp" as="image" type="image/webp" />
    <link rel="preload" href="/images/og-image.webp" as="image" type="image/webp" />
    
    <!-- DNS Prefetch pour les domaines externes -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//fonts.gstatic.com" />
    <link rel="dns-prefetch" href="//cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="//www.google-analytics.com" />
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />
    
    <!-- Preconnect pour les connexions critiques -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Meta tags pour les réseaux sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteConfig.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Harmonia" />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@maisonsattvaia" />
    <meta name="twitter:creator" content="@maisonsattvaia" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteConfig.site)} />
    <meta name="twitter:image:alt" content="La Maison Sattvaïa - Naturopathie & Soins Énergétiques à Salazac" />
    <meta name="twitter:domain" content="maisonsattvaia.fr" />
    
    <!-- Meta tags de performance -->
    <meta name="theme-color" content="#4F46E5" />
    <meta name="color-scheme" content="light dark" />
    
    <!-- Noindex si demandé -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "La Maison Sattvaïa",
      "description": description,
      "url": siteConfig.site,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${siteConfig.site}/search?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    
    <!-- Local Business Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "La Maison Sattvaïa",
      "description": "Accompagnement holistique unique alliant naturopathie, soins énergétiques et guidance spirituelle pour humains et animaux.",
      "url": siteConfig.site,
      "telephone": "+33 6 XX XX XX XX",
      "email": "contact@harmonia.jules.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "France",
        "addressCountry": "FR"
      },
      "priceRange": "€€",
      "image": new URL("/images/og-image.webp", siteConfig.site).toString(),
      "logo": new URL("/favicon.svg", siteConfig.site).toString(),
      "sameAs": [
        "https://www.facebook.com/maisonsattvaia",
        "https://www.instagram.com/maisonsattvaia"
      ]
    })} />
    
    <!-- Inline CSS critique -->
    <style is:inline>
      /* CSS critique pour éviter le FOUC */
      body { margin: 0; font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
      .loading { opacity: 0; transition: opacity 0.3s ease-in; }
      .loaded { opacity: 1; }
      
      /* Optimisation du rendu des polices */
      .font-display-swap { font-display: swap; }
      
      /* Optimisation des images */
      img { 
        max-width: 100%; 
        height: auto; 
        loading: lazy;
        decoding: async;
        /* Amélioration de l'accessibilité */
        alt: "";
      }
      
      /* Images sans ALT - affichage d'un indicateur */
      img:not([alt]) {
        border: 2px dashed #ff6b6b;
        position: relative;
      }
      
      img:not([alt])::after {
        content: "ALT manquant";
        position: absolute;
        top: 0;
        left: 0;
        background: #ff6b6b;
        color: white;
        padding: 2px 4px;
        font-size: 10px;
      }
      
      /* Optimisation du scroll */
      html { scroll-behavior: smooth; }
      
      /* Optimisation du focus */
      :focus { outline: 2px solid #4F46E5; outline-offset: 2px; }
      
      /* Optimisation des performances */
      * { box-sizing: border-box; }
      
      /* Optimisation du rendu */
      .loading { opacity: 0; transition: opacity 0.3s ease-in; }
      .loaded { opacity: 1; }
      
      /* Optimisation des animations */
      @media (prefers-reduced-motion: reduce) {
        * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
      }
    </style>
    
    <title>{title}</title>
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="loading">
    <slot />
    
    <!-- Script d'initialisation des métriques SEO -->
    <script is:inline>
      // Initialisation des métriques SEO
      if (typeof window !== 'undefined') {
        // Mesurer les Core Web Vitals
        new PerformanceObserver((entryList) => {
          const entries = entryList.getEntries();
          const lastEntry = entries[entries.length - 1];
          if (window.gtag) {
            window.gtag('event', 'lcp_measurement', {
              event_category: 'performance',
              value: Math.round(lastEntry.startTime)
            });
          }
        }).observe({ entryTypes: ['largest-contentful-paint'] });

        // Mesurer la profondeur de scroll
        let maxScroll = 0;
        const scrollThresholds = [25, 50, 75, 90, 100];
        
        window.addEventListener('scroll', () => {
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const scrollPercent = (scrollTop / docHeight) * 100;
          
          if (scrollPercent > maxScroll) {
            maxScroll = scrollPercent;
            
            scrollThresholds.forEach(threshold => {
              if (scrollPercent >= threshold && maxScroll < threshold + 10) {
                if (window.gtag) {
                  window.gtag('event', 'scroll_depth', {
                    event_category: 'engagement',
                    value: threshold
                  });
                }
              }
            });
          }
        });

        // Mesurer le temps sur la page
        const startTime = Date.now();
        window.addEventListener('beforeunload', () => {
          const timeOnPage = Math.round((Date.now() - startTime) / 1000);
          if (window.gtag) {
            window.gtag('event', 'time_on_page', {
              event_category: 'engagement',
              value: timeOnPage
            });
          }
        });
      }
    </script>
    
    <!-- Script de chargement optimisé -->
    <script is:inline>
      // Marquer la page comme chargée
      document.addEventListener('DOMContentLoaded', function() {
        document.body.classList.add('loaded');
      });
      
      // Optimisation du lazy loading
      if ('IntersectionObserver' in window) {
        const imageObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target;
              img.src = img.dataset.src;
              img.classList.remove('lazy');
              observer.unobserve(img);
            }
          });
        });
        
        document.querySelectorAll('img[data-src]').forEach(img => {
          imageObserver.observe(img);
        });
      }
      
      // Optimisation du service worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(registration => {
              console.log('SW registered: ', registration);
            })
            .catch(registrationError => {
              console.log('SW registration failed: ', registrationError);
            });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Optimisations globales de performance */
  
  /* Optimisation du rendu */
  * {
    box-sizing: border-box;
  }
  
  /* Optimisation des animations */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
  
  /* Optimisation des images */
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  
  /* Optimisation des liens */
  a {
    color: inherit;
    text-decoration: none;
  }
  
  /* Optimisation des boutons */
  button {
    border: none;
    background: none;
    cursor: pointer;
  }
  
  /* Optimisation des listes */
  ul, ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  /* Optimisation des formulaires */
  input, textarea, select {
    font-family: inherit;
    font-size: inherit;
  }
  
  /* Optimisation du focus */
  :focus-visible {
    outline: 2px solid #4F46E5;
    outline-offset: 2px;
  }
  
  /* Optimisation du scroll */
  html {
    scroll-behavior: smooth;
  }
  
  /* Optimisation des polices */
  .font-display-swap {
    font-display: swap;
  }
  
  /* Optimisation des transitions */
  .transition-optimized {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Optimisation des animations */
  .animate-optimized {
    animation-fill-mode: both;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

---
export const prerender = false;

// src/layouts/Layout.astro
import type { SEO } from '../lib/seo';
import { getSiteConfig } from '../lib/site-config';
import { initSEOMetrics } from '../lib/analytics';
import Analytics from '@vercel/analytics/astro';
import  SpeedInsights  from "@vercel/speed-insights/astro";
import GoogleTagManager from '../components/GoogleTagManager.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  seo?: SEO;
}

const {
  title = 'La Maison Sattvaïa - Naturopathie & Soins Énergétiques',
  description = 'Découvrez mes services de naturopathie et soins énergétiques pour votre bien-être naturel.',
  image = '/images/og-image.webp',
  canonical,
  noindex = false,
  seo = {}
} = Astro.props;

const siteConfig = getSiteConfig();
const canonicalURL = canonical ? new URL(canonical, siteConfig.site) : new URL(Astro.url.pathname, siteConfig.site);
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <GoogleTagManager placement="head" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SM770CEFD5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-SM770CEFD5');
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons (dossier /public/favicon/) -->
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/web-app-manifest-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon/web-app-manifest-512x512.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload uniquement la police critique -->
    <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    
    <!-- Preload uniquement l'image hero -->
    <link rel="preload" href="/images/hero-bg.webp" as="image" type="image/webp" />
    
    <!-- DNS Prefetch optimisé pour mobile -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//fonts.gstatic.com" />
    
    <!-- Preconnect uniquement pour les ressources critiques -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Meta tags pour les réseaux sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteConfig.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="La Maison Sattvaïa" />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@maisonsattvaia" />
    <meta name="twitter:creator" content="@maisonsattvaia" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteConfig.site)} />
    <meta name="twitter:image:alt" content="La Maison Sattvaïa - Naturopathie & Soins Énergétiques à Salazac" />
    <meta name="twitter:domain" content="maisonsattvaia.fr" />
    
    <!-- Meta tags de performance -->
    <meta name="theme-color" content="#4A6741" />
    <meta name="color-scheme" content="light dark" />
    
    <!-- Noindex si demandé -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "La Maison Sattvaïa",
      "description": description,
      "url": typeof siteConfig.site === 'string' ? siteConfig.site.replace(/\/$/, '') : siteConfig.site,
    })} />
    
    <!-- Local Business Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "La Maison Sattvaïa",
      "description": "Accompagnement holistique unique alliant naturopathie, soins énergétiques et guidance spirituelle pour humains et animaux.",
      "url": siteConfig.site,
      "telephone": "+33 6 XX XX XX XX",
      "email": "contact@harmonia.jules.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "France",
        "addressCountry": "FR"
      },
      "priceRange": "€€",
      "image": new URL("/images/og-image.webp", siteConfig.site).toString(),
      "logo": new URL("/favicon/favicon.svg", siteConfig.site).toString(),
      "sameAs": [
        "https://www.facebook.com/maisonsattvaia",
        "https://www.instagram.com/maisonsattvaia"
      ]
    })} />
    
    <!-- CSS critique minimal pour mobile -->
    <style is:inline>
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
      img { max-width: 100%; height: auto; loading: lazy; }
      * { box-sizing: border-box; }
    </style>
    
    <title>{title}</title>
  </head>
  <body>
    <GoogleTagManager placement="body" />
    <slot />
    
    <!-- Analytics chargés de manière asynchrone -->
    <script>
      // Charger les analytics après le rendu critique
      requestIdleCallback(() => {
        // Charger Vercel Analytics
        import('@vercel/analytics/astro').then(module => {
          // Analytics chargé
        });
      });
    </script>
    
    <!-- Script de chargement optimisé -->
    <script is:inline>
      // Marquer la page comme chargée
      document.addEventListener('DOMContentLoaded', function() {
        document.body.classList.add('loaded');
      });
      
      // Optimisation du lazy loading
      if ('IntersectionObserver' in window) {
        const imageObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target;
              img.src = img.dataset.src;
              img.classList.remove('lazy');
              observer.unobserve(img);
            }
          });
        });
        
        document.querySelectorAll('img[data-src]').forEach(img => {
          imageObserver.observe(img);
        });
      }
      
      // Optimisation du service worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(registration => {
              console.log('SW registered: ', registration);
            })
            .catch(registrationError => {
              console.log('SW registration failed: ', registrationError);
            });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Optimisations globales de performance */
  
  /* Optimisation du rendu */
  * {
    box-sizing: border-box;
  }
  
  /* Optimisation des animations */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
  
  /* Optimisation des images */
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  
  /* Optimisation des liens */
  a {
    color: inherit;
    text-decoration: none;
  }
  
  /* Optimisation des boutons */
  button {
    border: none;
    background: none;
    cursor: pointer;
  }
  
  /* Optimisation des listes */
  ul, ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  /* Optimisation des formulaires */
  input, textarea, select {
    font-family: inherit;
    font-size: inherit;
  }
  
  /* Optimisation du focus */
  :focus-visible {
    outline: 2px solid #4F46E5;
    outline-offset: 2px;
  }
  
  /* Optimisation du scroll */
  html {
    scroll-behavior: smooth;
  }
  
  /* Optimisation des polices */
  .font-display-swap {
    font-display: swap;
  }
  
  /* Optimisation des transitions */
  .transition-optimized {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Optimisation des animations */
  .animate-optimized {
    animation-fill-mode: both;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

---
export const prerender = false;

import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import Cart from '../components/shop/Cart.astro';
import '../styles/theme.css';

// Récupération de l'utilisateur pour la navigation
const user = Astro.locals.user;

// Polices
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/raleway/300.css';
import '@fontsource/raleway/400.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/500.css';
import 'aos/dist/aos.css';


interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  twitterImageAlt?: string;
  articlePublishedTime?: string;
  /** Page pleine largeur sans header/footer/panier (ex. retour Stripe). */
  bare?: boolean;
}

const {
  title,
  description,
  image = '/images/social-share.webp',
  ogType = 'website',
  noindex = false,
  twitterImageAlt,
  articlePublishedTime,
  bare = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedImage =
  typeof image === 'string' && image.trim() !== '' ? image.trim() : '/images/social-share.webp';
const ogImageAbs = new URL(resolvedImage, Astro.site);
const twitterAlt =
  (twitterImageAlt && twitterImageAlt.trim()) || `${title} — La Maison Sattvaïa`;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <GoogleTagManager placement="head" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SM770CEFD5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-SM770CEFD5');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:site_name" content="Aïa - Naturopathe" />
    <meta property="og:locale" content="fr_FR" />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content="Aïa" />
    )}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@maisonsattvaia" />
    <meta name="twitter:creator" content="@maisonsattvaia" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={twitterAlt} />
    <meta name="twitter:domain" content="maisonsattvaia.fr" />

    <!-- Other meta tags -->
    <meta name="author" content="Aïa" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <meta name="keywords" content="naturopathie, santé naturelle, bien-être, soins énergétiques, accompagnement holistique, naturopathie animale" />
    <meta name="theme-color" content="#4A6741" />
    <meta name="geo.region" content="FR" />
    <meta name="geo.placename" content="France" />
    <meta name="language" content="fr" />
    <meta name="revisit-after" content="7 days" />
    <!-- Favicons (dossier /public/favicon/) -->
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon/web-app-manifest-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon/web-app-manifest-512x512.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/PlayfairDisplay-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/Raleway-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "La Maison Sattvaïa",
      "description": description,
      "url": Astro.site ? Astro.site.href.replace(/\/$/, '') : '',
    })} />
    
    <!-- Local Business Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "La Maison Sattvaïa",
      "description": "Accompagnement holistique unique alliant naturopathie, soins énergétiques et guidance spirituelle pour humains et animaux.",
      "url": Astro.site,
      "telephone": "+33 7 67 22 97 43",
      "email": "contact@maisonsattvaia.fr",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Salazac",
        "addressRegion": "Gard",
        "postalCode": "30760",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 44.2333,
        "longitude": 4.4167
      },
      "openingHours": [
        "Mo-Fr 09:00-18:00",
        "Sa 09:00-17:00"
      ],
      "priceRange": "€€",
      "image": new URL("/images/og-image.webp", Astro.site).toString(),
      "logo": new URL("/favicon/favicon.svg", Astro.site).toString(),
      "serviceArea": {
        "@type": "GeoShape",
        "description": "Gard, Vaucluse, Drôme, Ardèche"
      },
      "areaServed": [
        {
          "@type": "GeoCircle",
          "geoMidpoint": {
            "@type": "GeoCoordinates",
            "latitude": 44.2333,
            "longitude": 4.4167
          },
          "geoRadius": 80000
        }
      ],
      "sameAs": [
        "https://www.facebook.com/maisonsattvaia",
        "https://www.instagram.com/maisonsattvaia"
      ]
    })} />
    
    <!-- Services Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Naturopathie et Soins Énergétiques",
      "description": "Accompagnement holistique personnalisé : naturopathie humaine et animale, soins énergétiques et guidance spirituelle.",
      "provider": {
        "@type": "LocalBusiness",
        "name": "La Maison Sattvaïa"
      },
      "areaServed": "Gard, Vaucluse, Drôme, Ardèche",
      "availableChannel": {
        "@type": "ServiceChannel",
        "serviceType": "Consultation en présentiel ou à distance"
      },
      "offers": {
        "@type": "Offer",
        "price": "80",
        "priceCurrency": "EUR",
        "availability": "https://schema.org/InStock"
      }
    })} />
  </head>
  <body
    class:list={[
      'min-h-screen flex flex-col text-ebony overflow-x-hidden',
      bare && 'bg-[#f5f5f5]',
    ]}
  >
    <GoogleTagManager placement="body" />
    {!bare && <Navigation />}
    <main
      class:list={[
        'w-full overflow-x-hidden',
        bare && 'flex flex-1 flex-col justify-center',
      ]}
    >
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <Cart />}
    {!bare && (
      <script>
        import AOS from 'aos';

        const getResponsiveOffset = () => {
          const width = window.innerWidth;
          if (width < 768) return 20;
          if (width < 1024) return 20;
          return 60;
        };

        document.addEventListener('DOMContentLoaded', () => {
          AOS.init({
            duration: 800,
            once: true,
            offset: getResponsiveOffset(),
            disable: false,
            startEvent: 'load',
            disableMutationObserver: true,
            mirror: false,
            anchorPlacement: 'top-center',
            easing: 'ease-out-cubic',
          });

          window.addEventListener('resize', () => {
            AOS.refresh();
          });
        });
      </script>
    )}
  </body>
</html>

<style is:global>
  /* Correction du masquage par la navigation fixe */
  .hero-section {
    padding-top: 4rem; /* 64px pour mobile */
  }
  
  @media (min-width: 1280px) {
    .hero-section {
      padding-top: 6rem; /* 96px pour desktop */
    }
  }
  
  /* Alternative pour les sections qui utilisent min-h-screen */
  .min-h-screen.hero-section {
    padding-top: 0;
    margin-top: 4rem; /* 64px pour mobile */
  }
  
  @media (min-width: 1280px) {
    .min-h-screen.hero-section {
      margin-top: 6rem; /* 96px pour desktop */
    }
  }
  
  /* Correction spécifique pour les pages accompagnements avec contenu centré */
  .min-h-screen.hero-section .min-h-screen {
    min-height: calc(100vh - 4rem); /* 64px pour mobile */
    padding-top: 4rem; /* 64px pour mobile */
  }
  
  @media (min-width: 1280px) {
    .min-h-screen.hero-section .min-h-screen {
      min-height: calc(100vh - 6rem); /* 96px pour desktop */
      padding-top: 6rem; /* 96px pour desktop */
    }
  }
  
  /* Pour les sections avec min-h-[60vh] ou autres hauteurs spécifiques */
  .min-h-\[60vh\].hero-section {
    padding-top: 0;
    margin-top: 4rem; /* 64px pour mobile */
  }
  
  @media (min-width: 1280px) {
    .min-h-\[60vh\].hero-section {
      margin-top: 6rem; /* 96px pour desktop */
    }
  }

  /* Accueil (Hero h-[80vh]) — même bande crème que Contact (margin, pas padding) */
  .h-\[80vh\].hero-section {
    padding-top: 0;
    margin-top: 4rem;
  }

  @media (min-width: 1280px) {
    .h-\[80vh\].hero-section {
      margin-top: 6rem;
    }
  }

  /* À propos — min-h-[72vh] md:min-h-[78vh] */
  .min-h-\[72vh\].hero-section {
    padding-top: 0;
    margin-top: 4rem;
  }

  @media (min-width: 1280px) {
    .min-h-\[72vh\].hero-section {
      margin-top: 6rem;
    }
  }

  /* SATTVA / naturopathie humaine — min-h-[85vh] */
  .min-h-\[85vh\].hero-section {
    padding-top: 0;
    margin-top: 4rem;
  }

  @media (min-width: 1280px) {
    .min-h-\[85vh\].hero-section {
      margin-top: 6rem;
    }
  }

  :root {
    --color-primary: #4A6741;
    --color-secondary: #D4C9B9;
    --color-text: #2C3B2A;
  }
  
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Raleway', sans-serif;
    color: var(--color-text);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Playfair Display', serif;
  }

  .logo-font {
    font-family: 'Great Vibes', cursive;
  }

  /* Amélioration de l'accessibilité */
  :focus:not(:focus-visible) {
    outline: none;
  }

  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Responsive text sizes */
  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem !important;
    }
    h2 {
      font-size: 2rem !important;
    }
    h3 {
      font-size: 1.75rem !important;
    }
    .text-lg {
      font-size: 1rem !important;
    }
    .container {
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
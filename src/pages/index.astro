---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import HomePourquoi from '../components/HomePourquoi.astro';
import HomePillars from '../components/HomePillars.astro';
import HomeToolkit from '../components/HomeToolkit.astro';
import ResultsTestimonials from '../components/ResultsTestimonials.astro';
import HomeClosing from '../components/HomeClosing.astro';
import { pageSEO } from '../lib/seo';

export const prerender = false;

const seo = pageSEO.home;
---

<MainLayout title={seo.title} description={seo.description} image={seo.image}>
  <div class="relative">
    <Hero />
  </div>

  <div class="relative">
    <HomePourquoi />
  </div>

  <div class="relative">
    <HomePillars />
  </div>

  <div class="relative">
    <HomeToolkit />
  </div>

  <div class="relative">
    <ResultsTestimonials />
  </div>

  <div class="relative">
    <HomeClosing />
  </div>
</MainLayout>

---
export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`, 302);
}

import { createServerClient } from "@supabase/ssr";

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL!,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY!,
  {
    cookies: {
      get: (k) => Astro.cookies.get(k)?.value,
      set: (k, v, o) => Astro.cookies.set(k, v, o),
      remove: (k, o) => Astro.cookies.delete(k, o),
    },
  }
);

// Optionnel : lecture du profil si table `profiles` (ignorer si absent)
let profile = null;
try {
  const { data, error } = await supabase
    .from("profiles")
    .select("*")
    .eq("id", user.id)
    .maybeSingle();
  if (!error) profile = data ?? null;
} catch {}

// Récupération des commandes de l'utilisateur avec leurs produits
const { data: orders, error: ordersError } = await supabase
  .from('orders')
  .select(`
    id,
    user_id,
    total_amount,
    status,
    created_at,
    stripe_session_id
  `)
  .eq('user_id', user.id)
  .order('created_at', { ascending: false });

// Si on a des commandes, récupérer les order_items séparément
if (orders && orders.length > 0) {
  const orderIds = orders.map(o => o.id);
  const { data: items, error: itemsError } = await supabase
    .from('order_items')
    .select(`
      id,
      order_id,
      product_id,
      quantity,
      price,
      products (
        id,
        title,
        price,
        pdf_path
      )
    `)
    .in('order_id', orderIds);

  // Associer les items à leurs commandes respectives
  if (items && !itemsError) {
    orders.forEach(order => {
      (order as any).order_items = items.filter(item => item.order_id === order.id);
    });
  }
}
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mon compte - La Maison Sattvaïa</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/PlayfairDisplay-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/Raleway-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <style>
      :root {
        --sage: #4A6741;
        --eucalyptus: #6B8E6B;
        --gold: #D4A373;
        --cream: #FAF9F7;
        --ebony: #2C3B2A;
      }
      .bg-sage { background-color: var(--sage); }
      .text-sage { color: var(--sage); }
      .bg-eucalyptus { background-color: var(--eucalyptus); }
      .text-eucalyptus { color: var(--eucalyptus); }
      .bg-gold { background-color: var(--gold); }
      .text-gold { color: var(--gold); }
      .bg-cream { background-color: var(--cream); }
      .text-cream { color: var(--cream); }
      .bg-ebony { background-color: var(--ebony); }
      .text-ebony { color: var(--ebony); }
      .font-heading { font-family: 'Playfair Display', serif; }
      .font-slogan { font-family: 'Lora', serif; }
      .font-body { font-family: 'Raleway', sans-serif; }
    </style>
  </head>
  <body class="min-h-screen bg-cream text-ebony">
    <!-- Navigation simple -->
    <nav class="bg-white shadow-sm border-b border-sage/10">
      <div class="container mx-auto px-4 py-4">
        <div class="flex justify-between items-center">
          <a href="/" class="text-2xl font-heading text-sage">La Maison Sattvaïa</a>
          <div class="flex items-center gap-4">
            <span class="text-eucalyptus">Bonjour, {user.email}</span>
            <form method="post" action="/logout" class="inline">
              <button type="submit" class="bg-sage text-white px-4 py-2 rounded-lg hover:bg-eucalyptus transition-colors">
                Déconnexion
              </button>
            </form>
          </div>
        </div>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-heading text-ebony mb-8">Mon compte</h1>
        
        <!-- Informations utilisateur -->
        <div class="bg-white rounded-2xl p-8 shadow-lg border border-sage/10 mb-8">
          <h2 class="text-2xl font-heading text-ebony mb-6">Informations personnelles</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-eucalyptus mb-2">Email</label>
              <p class="text-ebony font-medium">{user.email}</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-eucalyptus mb-2">Membre depuis</label>
              <p class="text-ebony font-medium">{new Date(user.created_at).toLocaleDateString('fr-FR')}</p>
            </div>
          </div>
        </div>

        <!-- Profil (si disponible) -->
        {profile && (
          <div class="bg-white rounded-2xl p-8 shadow-lg border border-sage/10 mb-8">
            <h2 class="text-2xl font-heading text-ebony mb-6">Profil</h2>
            <pre class="bg-sage/5 p-4 rounded-lg text-sm overflow-auto">{JSON.stringify(profile, null, 2)}</pre>
          </div>
        )}

        <!-- Commandes -->
        <div class="bg-white rounded-2xl p-8 shadow-lg border border-sage/10 mb-8">
          <h2 class="text-2xl font-heading text-ebony mb-6">Mes commandes</h2>
          {orders && orders.length > 0 ? (
            <div class="space-y-6">
              {orders.map((order) => (
                <div class="border border-sage/20 rounded-xl p-6">
                  <div class="flex justify-between items-start mb-4">
                    <div>
                      <h3 class="text-lg font-heading text-ebony">Commande #{order.id.slice(-8)}</h3>
                      <p class="text-eucalyptus text-sm">
                        {new Date(order.created_at).toLocaleDateString('fr-FR', { 
                          year: 'numeric', 
                          month: 'long', 
                          day: 'numeric' 
                        })}
                      </p>
                    </div>
                    <div class="text-right">
                      <div class="text-2xl font-heading text-ebony font-bold">{order.total_amount.toFixed(2)}€</div>
                      <span class={`px-3 py-1 rounded-full text-sm font-medium ${
                        order.status === 'completed' 
                          ? 'bg-green-100 text-green-800' 
                          : 'bg-yellow-100 text-yellow-800'
                      }`}>
                        {order.status === 'completed' ? 'Payée' : 'En cours'}
                      </span>
                    </div>
                  </div>

                  <!-- Articles de la commande -->
                  <div class="space-y-3">
                    {((order as any).order_items || [])?.map((item) => (
                      <div class="bg-sage/5 rounded-lg p-4">
                        <div class="flex justify-between items-start">
                          <div class="flex-1">
                            <h4 class="font-medium text-ebony">
                              {item.products?.title || 'Produit non trouvé'}
                            </h4>
                            <p class="text-eucalyptus text-sm">Quantité: {item.quantity}</p>
                          </div>
                          <div class="text-right">
                            <div class="text-lg font-heading text-ebony font-bold">
                              {item.products?.price?.toFixed(2) || '0.00'}€
                            </div>
                          </div>
                        </div>

                        {item.products?.pdf_path && (
                          <div class="mt-3 flex items-center justify-between bg-white rounded-lg p-3">
                            <div class="flex items-center gap-3">
                              <div class="w-8 h-8 rounded-full bg-sage flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                              </div>
                              <div>
                                <p class="text-sm font-medium text-ebony">PDF disponible</p>
                              </div>
                            </div>
                            <a 
                              href={`/api/download?productId=${item.products.id}&orderId=${order.id}`}
                              class="bg-sage text-white px-4 py-2 rounded-lg hover:bg-eucalyptus transition-colors flex items-center gap-2"
                            >
                              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                              </svg>
                              Télécharger
                            </a>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-12">
              <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-sage/20 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-sage" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
              </div>
              <h3 class="text-xl font-heading text-ebony mb-2">Aucune commande pour le moment</h3>
              <p class="text-eucalyptus mb-6">Découvrez notre sélection de guides et accompagnements.</p>
              <a 
                href="/boutique" 
                class="inline-flex items-center gap-2 bg-sage text-white px-6 py-3 rounded-lg hover:bg-eucalyptus transition-colors"
              >
                Découvrir nos guides
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
          )}
        </div>

        <!-- Accès admin (si applicable) -->
        {(profile?.role === 'admin' || user.email === 'tyzranaima@gmail.com') && (
          <div class="bg-white rounded-2xl p-8 shadow-lg border border-sage/10">
            <h2 class="text-2xl font-heading text-ebony mb-6">Administration</h2>
            <div class="grid md:grid-cols-3 gap-4">
              <a 
                href="/admin/boutique"
                class="bg-sage/10 hover:bg-sage/20 text-sage px-6 py-4 rounded-lg transition-colors text-center"
              >
                <div class="w-12 h-12 mx-auto mb-2 rounded-full bg-sage flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                </div>
                <div class="font-medium">Boutique</div>
                <div class="text-sm text-eucalyptus">Gérer les produits</div>
              </a>

              <a 
                href="/admin/disponibilites"
                class="bg-sage/10 hover:bg-sage/20 text-sage px-6 py-4 rounded-lg transition-colors text-center"
              >
                <div class="w-12 h-12 mx-auto mb-2 rounded-full bg-sage flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="font-medium">Disponibilités</div>
                <div class="text-sm text-eucalyptus">Gérer les rendez-vous</div>
              </a>

              <a 
                href="/admin/blog"
                class="bg-sage/10 hover:bg-sage/20 text-sage px-6 py-4 rounded-lg transition-colors text-center"
              >
                <div class="w-12 h-12 mx-auto mb-2 rounded-full bg-sage flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                </div>
                <div class="font-medium">Blog</div>
                <div class="text-sm text-eucalyptus">Gérer les articles</div>
              </a>
            </div>
          </div>
        )}
      </div>
    </main>
  </body>
</html>